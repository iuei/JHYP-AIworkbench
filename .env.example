VITE_API_BASE_URL=http://localhost:8787/api
PGHOST=localhost
PGPORT=5432
PGDATABASE=jhyp_workbench
PGUSER=postgres
PGPASSWORD=
JWT_SECRET=replace-with-a-long-random-string
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_PASSWORD=

# AI 助手：模型密钥与连接参数
# 优先级：**后台配置（AI 助手 → 审计台 → 模型与配置）> 环境变量 > 演示模式**。
# 也就是说这里的值只是兜底：管理员在后台填过就以后台为准，改完即时生效、无需重启。
AI_MODEL_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_API_KEY=
AI_MODEL_NAME=deepseek-chat
AI_MODEL_TEMPERATURE=0.2
AI_MODEL_MAX_TOKENS=2048
AI_MODEL_TIMEOUT_MS=60000

# 后台保存的模型 API Key 用 AES-256-GCM 加密后存入 ai_settings，加密密钥取自这里。
# 未配置时回退 JWT_SECRET（开箱即用）。注意：换服务器要一并带走该 secret，
# 否则库里已有的密文解不开，需要到后台重新填一次 Key。
AI_SETTINGS_SECRET=

# 知识检索相关性下限（命中关键词数 / 关键词总数），默认 0.2。
# 调大到 0.3 以上会明显过度拒绝（实测空检索率升到 30%）；接入真实文档后
# 用 node server/ai-agent/eval/compare-retrieval.mjs 重新标定再改。
AI_RETRIEVAL_MIN_COVERAGE=0.2

# 卖家精灵（SellerSprite）MCP：外部数据工具。
# 优先级与模型密钥一致：**后台「模型与配置」页 > 环境变量 > 未启用**，这里只是本地开发兜底。
# 密钥在卖家精灵开放平台「我的密钥」创建（MCP 密钥与 API Key 是两套，别拿错）；
# 端点是 Streamable HTTP（POST），必须精确到 /mcp、不能带结尾斜杠。
# 工具清单需要在后台点「同步工具」写入 ai_tools，只配密钥不会注册任何工具。
AI_MCP_ENABLED=false
AI_MCP_ENDPOINT=https://mcp.sellersprite.com/mcp
AI_MCP_PREFIX=sellersprite
AI_MCP_SECRET=
AI_MCP_TIMEOUT_MS=30000
