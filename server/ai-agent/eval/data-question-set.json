      "expectBlocks": [
        "metrics",
        "table",
        "chart"
      ],
      "truth": {
        "type": "amazon",
        "params": {
          "asin": "B0SAMPLE01",
          "marketplace": "US",
          "startDate": "2026-08-01",
          "endDate": "2026-08-31",
          "compareWith": "previous_period"
        },
        "fields": [
          {
            "from": "current.acos",
            "digits": 1
          },
          {
            "from": "decomposition.totalDelta",
            "digits": 1
          },
          {
            "from": "decomposition.salesEffect",
            "digits": 1
          }
